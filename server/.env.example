# ── Server ─────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:3000   # Production: https://bloodchain.vercel.app

# ── Database ────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/BLOODCHAIN?retryWrites=true&w=majority

# ── Authentication ──────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ── Encryption ──────────────────────────────────────────
AES_SECRET_KEY=your-32-character-aes-key-here!!

# ── IPFS / Pinata (optional — for file attachments) ─────
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_KEY=your-pinata-secret-key
PINATA_GATEWAY=https://gateway.pinata.cloud

# ── Blockchain (Ethereum Sepolia) ───────────────────────
# If omitted, the system runs in simulation mode — all data is saved
# to MongoDB but no real on-chain transactions are submitted.
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-alchemy-key>
SEPOLIA_PRIVATE_KEY=0x<your-wallet-private-key>

# ── Notes ───────────────────────────────────────────────
# To deploy the Solidity contract:
#   cd server && npx hardhat run scripts/deploy.js --network sepolia
# Then paste the deployed address into CONTRACT_ADDRESS above.
